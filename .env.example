<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Horizon — Agent Gateway (Black hole / White hole)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#eeedf8;--fg:#14132a;--muted:#5b5977;--a:#3a4bff;--b:#9b3dff;--m:#6f5bff;--card:rgba(255,255,255,.62);--line:rgba(20,19,42,.13);--hole:#fff;--g1:#3a4bff;--g2:#8b3dff;--bf:#fff;--sh:rgba(80,70,255,.35);--glow:rgba(110,90,255,.16);color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#040409;--fg:#ecebf5;--muted:#8f8da8;--a:#ff9a3c;--b:#8b5cf6;--m:#ffd9a8;--card:rgba(255,255,255,.04);--line:rgba(255,255,255,.1);--hole:#000;--g1:#ff9a3c;--g2:#ff6a3c;--bf:#1a0a00;--sh:rgba(255,140,50,.35);--glow:rgba(255,140,50,.14);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#040409;--fg:#ecebf5;--muted:#8f8da8;--a:#ff9a3c;--b:#8b5cf6;--m:#ffd9a8;--card:rgba(255,255,255,.04);--line:rgba(255,255,255,.1);--hole:#000;--g1:#ff9a3c;--g2:#ff6a3c;--bf:#1a0a00;--sh:rgba(255,140,50,.35);--glow:rgba(255,140,50,.14);color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*:before,*:after{box-sizing:inherit}
body{margin:0;transition:background .4s,color .4s;background:var(--bg);color:var(--fg);font-family:'Space Grotesk',system-ui,sans-serif;line-height:1.6;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
nav{position:absolute;top:0;left:0;right:0;z-index:5}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:70px}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:.02em}
.logo i{width:18px;height:18px;border-radius:50%;background:var(--hole);box-shadow:0 0 0 2px var(--a),0 0 14px var(--a)}
.links{display:flex;gap:26px;align-items:center;color:var(--muted);font-size:15px}
.links a:hover{color:var(--fg)}
.btn{display:inline-block;padding:12px 24px;border-radius:999px;font-weight:500;border:1px solid var(--line);transition:.25s}
.btn.p{background:linear-gradient(135deg,var(--g1),var(--g2));color:var(--bf);border:0;box-shadow:0 0 30px var(--sh)}
.btn.p:hover{transform:translateY(-2px);box-shadow:0 0 44px rgba(255,140,50,.55)}
.btn.g:hover{background:var(--card)}
#tg{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:16px;cursor:pointer}
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding:0 0 70px;overflow:hidden}
#bh{position:absolute;inset:0;width:100%;height:100%}
.hero:after{content:"";position:absolute;left:0;right:0;bottom:0;height:45%;background:linear-gradient(transparent,var(--bg) 85%);pointer-events:none}
.hero .wrap{position:relative;z-index:2;text-align:center}
.tag{display:inline-block;font:500 12px 'JetBrains Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--a);border:1px solid var(--line);padding:6px 14px;border-radius:999px;background:var(--card)}
h1{font-size:clamp(36px,6.4vw,76px);line-height:1.04;margin:20px 0 16px;letter-spacing:-.03em}
h1 span{background:linear-gradient(90deg,var(--a),var(--m) 50%,var(--b));-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{max-width:640px;margin:0 auto 30px;color:var(--muted);font-size:clamp(16px,2vw,19px)}
.cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
section{padding:90px 0;position:relative}
.eyebrow{font:500 12px 'JetBrains Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--a)}
h2{font-size:clamp(28px,4vw,44px);letter-spacing:-.02em;line-height:1.1;margin:10px 0 14px}
.lead{color:var(--muted);max-width:560px;margin:0 0 44px}
.grid{display:grid;gap:18px}
.g3{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.g2{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:26px;transition:.3s;backdrop-filter:blur(6px)}
.card:hover{border-color:var(--a);transform:translateY(-4px);box-shadow:0 12px 40px -12px rgba(255,140,50,.25)}
.card h3{margin:0 0 8px;font-size:19px}
.card p{margin:0;color:var(--muted);font-size:15px}
.num{font:500 13px 'JetBrains Mono',monospace;color:var(--a);margin-bottom:14px;display:block}
.split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
@media(max-width:820px){.split{grid-template-columns:1fr}.links a:not(.btn){display:none}}
.code{background:#07070f;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 0 60px -20px rgba(139,92,246,.5)}
.code .bar{display:flex;gap:7px;padding:12px 16px;border-bottom:1px solid var(--line)}
.code .bar b{width:10px;height:10px;border-radius:50%;background:#2a2a3a}
.code pre{margin:0;padding:20px;overflow-x:auto;font:400 13px/1.7 'JetBrains Mono',monospace;color:#cfcde6}
.k{color:#c4a1ff}.s{color:#ffc58a}.c{color:#6c6a85}
.checks{list-style:none;padding:0;margin:20px 0 0;color:var(--muted)}
.checks li{padding-left:28px;position:relative;margin:10px 0}
.checks li:before{content:"";position:absolute;left:0;top:9px;width:10px;height:10px;border-radius:50%;background:var(--a);box-shadow:0 0 10px var(--a)}
.final{text-align:center;padding:110px 0}
.final:before{content:"";position:absolute;left:50%;top:50%;width:620px;max-width:100%;height:620px;transform:translate(-50%,-50%);background:radial-gradient(circle,var(--glow),transparent 68%);pointer-events:none}
.final .wrap{position:relative}
.final p{color:var(--muted);margin:0 auto 30px;max-width:480px}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
.js .rv{opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s}
.js .rv.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.js .rv{opacity:1;transform:none;transition:none}}
</style>
</head>
<body>
<nav><div class="wrap">
  <a class="logo" href="#"><i></i>Horizon</a>
  <div class="links"><a href="#how">How it works</a><a href="#features">Features</a><a href="#api">API</a><button id="tg" aria-label="Toggle light or dark theme"></button><a class="btn g" href="#join">Get access</a></div>
</div></nav>

<header class="hero">
  <canvas id="bh" aria-hidden="true"></canvas>
  <div class="wrap">
    <span class="tag">Agent Gateway · Early Access</span>
    <h1>Send your agents past the <span>event horizon</span></h1>
    <p class="sub">Register agents, set their initial config, and call one API. We run the architecture, orchestration and pipeline underneath — you ship the product.</p>
    <div class="cta"><a class="btn p" href="#join">Get early access</a><a class="btn g" href="#api">See the API</a></div>
  </div>
</header>

<section id="how"><div class="wrap">
  <div class="rv"><span class="eyebrow">How it works</span><h2>Three steps. Zero pipeline code.</h2><p class="lead">The heavy lifting stays inside the gravity well. You only configure what makes your agent yours.</p></div>
  <div class="grid g3">
    <div class="card rv"><span class="num">01</span><h3>Register</h3><p>Create an account and spin up an agent in seconds — one per app, workflow, or customer.</p></div>
    <div class="card rv"><span class="num">02</span><h3>Configure</h3><p>Pick a base template, add your prompt config, and attach tools. Building a PDF editor? Drop in the preset and extend it.</p></div>
    <div class="card rv"><span class="num">03</span><h3>Integrate</h3><p>Call the gateway API from your app. We handle execution, tool calls, retries and state.</p></div>
  </div>
</div></section>

<section id="features"><div class="wrap">
  <div class="rv"><span class="eyebrow">Features</span><h2>Flexible on the surface. Heavy inside.</h2><p class="lead">Bring what you have, borrow what we've built.</p></div>
  <div class="grid g2">
    <div class="card rv"><h3>Bring your own tools</h3><p>Plug in your own functions and endpoints. Your agent calls them like any native tool.</p></div>
    <div class="card rv"><h3>Built-in gateway tools</h3><p>A growing library of tools we host and maintain, ready for any agent to call.</p></div>
    <div class="card rv"><h3>Managed agent architecture</h3><p>Planning, routing, memory and the pipeline internals are ours to run and improve — you never touch them.</p></div>
    <div class="card rv"><h3>Prompt &amp; config presets</h3><p>Start from use-case templates (PDF editor, support, research) and layer your own instructions on top.</p></div>
  </div>
</div></section>

<section id="api"><div class="wrap split">
  <div class="rv">
    <span class="eyebrow">Developer API</span><h2>One endpoint. Whole agent.</h2>
    <p class="lead" style="margin-bottom:0">Define the agent once, then talk to it from anywhere in your stack.</p>
    <ul class="checks"><li>Your tools + our tools in one config</li><li>Initial prompt config per agent</li><li>Pipeline handled server-side</li></ul>
  </div>
  <div class="code rv"><div class="bar"><b></b><b></b><b></b></div>
<pre><span class="c">// 1. create an agent</span>
<span class="k">POST</span> /v1/agents
{
  <span class="s">"name"</span>: <span class="s">"pdf-editor"</span>,
  <span class="s">"template"</span>: <span class="s">"document-editing"</span>,
  <span class="s">"prompt_config"</span>: <span class="s">"Edit PDFs. Be concise."</span>,
  <span class="s">"tools"</span>: [<span class="s">"gateway.ocr"</span>, <span class="s">"my_app.save_file"</span>]
}

<span class="c">// 2. run it</span>
<span class="k">POST</span> /v1/agents/pdf-editor/run
{ <span class="s">"input"</span>: <span class="s">"Merge pages 2-4 and rotate"</span> }</pre></div>
</div></section>

<section class="final" id="join"><div class="wrap rv">
  <h2>Ready to cross the horizon?</h2>
  <p>Join the early access list and build your first agent on the gateway.</p>
  <a class="btn p" href="#">Request access</a>
</div></section>

<footer><div class="wrap"><span>© 2026 Horizon. All rights reserved.</span><span>Docs · Pricing · Contact</span></div></footer>

<script>
document.documentElement.classList.add('js');
try{var io=new IntersectionObserver(function(e){e.forEach(function(i){if(i.isIntersecting){i.target.classList.add('in');io.unobserve(i.target)}})},{threshold:.12});document.querySelectorAll('.rv').forEach(function(n){io.observe(n)})}catch(e){document.querySelectorAll('.rv').forEach(function(n){n.classList.add('in')})}

(function(){
var root=document.documentElement,mq=matchMedia('(prefers-color-scheme: dark)'),tg=document.getElementById('tg');
function isL(){var d=root.dataset.theme;return d?d==='light':!mq.matches}
function icon(){tg.textContent=isL()?'☾':'☀'}
tg.onclick=function(){root.dataset.theme=isL()?'dark':'light';icon()};icon();
var c=document.getElementById('bh'),gl=c.getContext('webgl',{antialias:false,alpha:false});
function fb(){c.parentElement.style.background='radial-gradient(circle at 50% 38%,#000 0 5%,rgba(255,150,60,.45) 6%,transparent 26%)'}
if(!gl){fb();return}
var VS='attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
var FS=`precision highp float;
uniform vec2 R,M;uniform float T,Y,W;
float h(vec3 p){p=fract(p*.3183099+.1);p*=17.;return fract(p.x*p.y*p.z*(p.x+p.y+p.z));}
float n3(vec3 x){vec3 i=floor(x),f=fract(x);f=f*f*(3.-2.*f);
return mix(mix(mix(h(i),h(i+vec3(1,0,0)),f.x),mix(h(i+vec3(0,1,0)),h(i+vec3(1,1,0)),f.x),f.y),
mix(mix(h(i+vec3(0,0,1)),h(i+vec3(1,0,1)),f.x),mix(h(i+vec3(0,1,1)),h(i+vec3(1,1,1)),f.x),f.y),f.z);}
float fbm(vec3 p){float a=.5,s=0.;for(int i=0;i<4;i++){s+=a*n3(p);p*=2.03;a*=.5;}return s;}
vec3 bb(float t){t=clamp(t,0.,1.6);
vec3 c=mix(vec3(.25,.03,0.),vec3(1.,.32,.05),smoothstep(0.,.45,t));
c=mix(c,vec3(1.,.72,.38),smoothstep(.4,.85,t));
c=mix(c,vec3(1.,.95,.88),smoothstep(.8,1.3,t));
return mix(c,vec3(.8,.88,1.),smoothstep(1.3,1.6,t));}
vec3 bg(vec3 d){
vec3 c=vec3(.012,.012,.03)+vec3(.10,.05,.16)*pow(fbm(d*2.+5.),3.)*1.4;
for(int L=0;L<2;L++){float s=(L==0)?90.:160.;vec3 p=d*s,i=floor(p),f=fract(p)-.5;float r=h(i+float(L)*7.3);
if(r>.955){vec3 o=vec3(h(i+1.7),h(i+4.1),h(i+9.3))-.5;
c+=vec3(.9,.92,1.)*smoothstep(.14,0.,length(f-o*.6))*(r-.955)*26.;}}
return c;}
void main(){
vec2 uv=(gl_FragCoord.xy-R*vec2(.5,Y))/(min(R.x,R.y*1.25)*.5);
float el=.15+M.y*.06+.012*sin(T*.2);
vec3 pos=29.*vec3(0.,sin(el),-cos(el));
vec3 f=-normalize(pos),rt=normalize(cross(vec3(0.,1.,0.),f)),uu=cross(f,rt);
vec3 vel=normalize(f*2.1+rt*uv.x+uu*uv.y);
vec3 hh=cross(pos,vel);float h2=dot(hh,hh);
vec3 col=vec3(0.);float al=0.,gw=0.;bool cap=false;
for(int i=0;i<230;i++){
float r=length(pos);
if(r<1.){cap=true;break;}
if(r>40.&&dot(pos,vel)>0.)break;
float dt=clamp(.045*r,.02,.9);
vec3 np=pos+vel*dt;
if(pos.y*np.y<0.&&al<.97){
vec3 q=mix(pos,np,pos.y/(pos.y-np.y));float rq=length(q.xz);
if(rq>3.&&rq<13.){
float ph=atan(q.z,q.x)-T*2.4*pow(rq,-1.5);
float n=fbm(vec3(cos(ph)*2.2,sin(ph)*2.2,rq*3.2));
float edge=smoothstep(3.,3.5,rq)*(1.-smoothstep(9.,13.,rq));
float a=edge*(.2+.8*smoothstep(.28,.72,n));
vec3 vd=normalize(vec3(-q.z,0.,q.x));
float be=sqrt(.5/(rq-1.));
float g=sqrt(1.-be*be)/(1.-be*dot(vd,-vel))*sqrt(1.-1./rq);
float tt=pow(3./rq,.75)*g*.95;
float I=pow(3./rq,1.5)*(.35+1.3*n)*pow(min(g,1.8),3.);
col+=(1.-al)*a*bb(tt)*I*2.2;
al+=(1.-al)*a;}}
gw+=dt*exp(-pow((r-1.6)*2.5,2.));
vel=normalize(vel-1.5*h2*pos/(r*r*r*r*r)*dt);
pos=np;}
if(cap)gw=0.;
if(!cap)col+=(1.-al)*bg(normalize(vel));
col+=vec3(1.,.6,.28)*gw*.3*(1.-al*.7);
vec3 tn=1.-exp(-col*1.3);
if(W>.5){float gb=exp(-pow(length(uv)/.55,2.));
vec3 base=cap?vec3(1.):mix(vec3(.933,.929,.973),vec3(1.),gb);
tn=base*(1.-tn*vec3(.85,.7,.35));}
tn+=(h(vec3(gl_FragCoord.xy,fract(T)*50.))-.5)*.018;
gl_FragColor=vec4(tn,1.);}`;
function sh(t,s){var o=gl.createShader(t);gl.shaderSource(o,s);gl.compileShader(o);return o}
var pr=gl.createProgram();
gl.attachShader(pr,sh(gl.VERTEX_SHADER,VS));gl.attachShader(pr,sh(gl.FRAGMENT_SHADER,FS));gl.linkProgram(pr);
if(!gl.getProgramParameter(pr,gl.LINK_STATUS)){fb();return}
gl.useProgram(pr);
var bf=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,bf);
gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);
var ap=gl.getAttribLocation(pr,'p');gl.enableVertexAttribArray(ap);gl.vertexAttribPointer(ap,2,gl.FLOAT,false,0,0);
var uW=gl.getUniformLocation(pr,'W'),uR=gl.getUniformLocation(pr,'R'),uM=gl.getUniformLocation(pr,'M'),uT=gl.getUniformLocation(pr,'T'),uY=gl.getUniformLocation(pr,'Y');
var reduce=matchMedia('(prefers-reduced-motion:reduce)').matches,live=true,q=1,W=0,tm=[0,0],m=[0,0],t=0,last=0,fc=0,acc=0;
function size(){var r=c.getBoundingClientRect();W=r.width;
var s=(W<700?.7:.9)*q;c.width=Math.max(2,r.width*s|0);c.height=Math.max(2,r.height*s|0);gl.viewport(0,0,c.width,c.height)}
addEventListener('pointermove',function(e){tm=[e.clientX/innerWidth-.5,e.clientY/innerHeight-.5]});
addEventListener('resize',size);size();
try{new IntersectionObserver(function(e){live=e[0].isIntersecting}).observe(c)}catch(e){}
function frame(ts){
requestAnimationFrame(frame);
if(!live){last=ts;return}
var dt=Math.min((ts-last)/1000,.05);last=ts;
t+=dt*(reduce?.1:1);
m[0]+=(tm[0]-m[0])*.05;m[1]+=(tm[1]-m[1])*.05;
acc+=dt;fc++;
if(fc==40){if(acc/fc>.04&&q>.45){q*=.8;size()}fc=0;acc=0}
gl.uniform2f(uR,c.width,c.height);gl.uniform2f(uM,m[0],m[1]);
gl.uniform1f(uW,isL()?1:0);gl.uniform1f(uT,t);gl.uniform1f(uY,W<700?.7:.63);
gl.drawArrays(gl.TRIANGLE_STRIP,0,4);}
requestAnimationFrame(frame);
})();
</script>
</body>
</html>